# ================================================================
# ScrapeForge — Environment Configuration
# ================================================================
# Copy this file to .env and fill in your values

# ── Server ──
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0

# ── MongoDB ──
MONGO_URI=mongodb://mongo:27017/scrapeforge
MONGO_DB_NAME=scrapeforge

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT Auth ──
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── API Key ──
API_KEY_SALT_ROUNDS=10
DEFAULT_CREDITS=1000
DEFAULT_RATE_LIMIT=60

# ── Proxy Providers (optional — uses MockProvider if not set) ──
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
PROXY_PROVIDER=mock

# ── CAPTCHA Solving Services (optional) ──
TWO_CAPTCHA_API_KEY=
CAPSOLVER_API_KEY=
ANTICAPTCHA_API_KEY=

# ── LLM Providers (for AI extraction) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_PROVIDER=openai

# ── Puppeteer / Chrome ──
CHROME_EXECUTABLE_PATH=
PUPPETEER_POOL_SIZE=5
PUPPETEER_RECYCLE_AFTER=50

# ── Selenium / ChromeDriver ──
SELENIUM_POOL_SIZE=5
SELENIUM_RECYCLE_AFTER=50

# ── Worker Concurrency ──
HTTP_WORKER_CONCURRENCY=200
BROWSER_WORKER_CONCURRENCY=50
CRAWL_WORKER_CONCURRENCY=100
SERP_WORKER_CONCURRENCY=200
NLP_WORKER_CONCURRENCY=50

# ── Domain Rate Limiting ──
DEFAULT_DOMAIN_RATE_LIMIT=10
DOMAIN_RATE_LIMIT_WINDOW=1000

# ── Proxy Checker ──
PROXY_CHECK_INTERVAL=300000
PROXY_MAX_CONSECUTIVE_FAILURES=3

# ── Scheduler ──
SCHEDULER_CHECK_INTERVAL=60000

# ── Change Detection ──
CHANGE_DETECT_BATCH_SIZE=100

# ── Cloud Storage (optional) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1
GCS_PROJECT_ID=
GCS_BUCKET=

# ── Email Notifications (optional) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@scrapeforge.io

# ── Logging ──
LOG_LEVEL=info
LOG_FORMAT=json

# ── Dashboard ──
DASHBOARD_PORT=5173
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000
